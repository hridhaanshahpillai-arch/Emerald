// SHARD: PIP AND THE EMERALD HEART
// A / D: run. W: jump (hold for higher; jump at a wall to kick off it).
// Space: dash, aimed with W A S D. Left click: swing (the yeti at the end needs it). Embers give the dash back. R: restart the level.

var LEVELS = [
    {"name": "1. THE MEADOW", "x": 0, "y": 0, "sx": 2, "sy": 13, "sky": 12},
    {"name": "2. WINDY RIDGE", "x": 48, "y": 0, "sx": 2, "sy": 13, "sky": 12},
    {"name": "3. SPRING WOODS", "x": 0, "y": 16, "sx": 2, "sy": 13, "sky": 9},
    {"name": "4. FROZEN CAVES", "x": 48, "y": 16, "sx": 2, "sy": 12, "sky": 1},
    {"name": "5. ICE FALLS", "x": 0, "y": 32, "sx": 2, "sy": 13, "sky": 1},
    {"name": "6. CRYSTAL HOLLOW", "x": 48, "y": 32, "sx": 2, "sy": 11, "sky": 2},
    {"name": "7. THE GLACIER", "x": 0, "y": 48, "sx": 2, "sy": 13, "sky": 1},
    {"name": "8. THE SUMMIT", "x": 48, "y": 48, "sx": 1, "sy": 13, "sky": 13},
    {"name": "9. THE YETI", "x": 96, "y": 0, "sx": 3, "sy": 13, "sky": 1, "w": 32, "boss": 1}
]
var HUB = -1     // no mountain hub: the levels come one after another
var BOSS = 8
var TOTAL = 9
var DOORS = [
    DOORS_TABLE
]
var GATES = [
    GATES_TABLE
]
var INTRO = [
    "LONG AGO THE EMERALD HEART KEPT THE MOUNTAIN GREEN AND WARM.",
    "THE VALLEY FOLK SAID IT BEAT ONCE A YEAR. AND EVERY TIME IT DID. SPRING CAME.",
    "BUT THIS YEAR SPRING NEVER CAME. THE RIVERS FROZE. THE FIELDS WENT GREY.",
    "PIP HAD JUST TURNED EIGHTEEN. HE HAD NEVER CLIMBED HIGHER THAN THE SHEEP FIELDS.",
    "BRAM: PIP! THE HEART HAS CRACKED. I SAW THE PIECES FLY UP THE MOUNTAIN.",
    "BRAM: NINE GREEN LIGHTS. LIKE SHOOTING STARS GOING THE WRONG WAY.",
    "BRAM: MY KNEES ARE TOO OLD FOR CLIMBING. TAKE MY RED SCARF. NOW GO!",
    "AT THE EDGE OF THE VILLAGE. BRAE WAS LEANING ON THE FENCE. LIKE SHE HAD BEEN WAITING FOR HIM.",
    "BRAE: CLIMBING A FROZEN MOUNTAIN ALONE? THAT IS EITHER VERY BRAVE OR VERY SILLY.",
    "BRAE: THE SCARF SUITS YOU. COME BACK IN ONE PIECE. I HAVE NOT FINISHED TEASING YOU YET.",
    "BRAE: OH. AND PIP? I HAVE ALWAYS HAD A SOFT SPOT FOR SOMEONE WHO WEARS GREEN.",
    "PIP LOOKED DOWN AT HIS GREEN TUNIC. THEN AT HIS GREEN CAP. THEN BACK AT BRAE.",
    "PIP WENT RED. BRAE LAUGHED ALL THE WAY HOME."
]
var STORY = [
    ["THE MEADOW. A GOOD PLACE TO START.",
     "HOLD W TO JUMP HIGHER. GRAB THE SHARD AT THE END."],
    ["UP ON THE RIDGE.",
     "ON THE RIDGE THE WIND HOWLS. THE GAPS ARE FAR TOO WIDE TO JUMP.",
     "BRAM (FAR BELOW): USE THE SCARF! IT REMEMBERS THE HEART. IT WILL CARRY YOU!",
     "PRESS Q TO DASH. AIM WITH W A S D.",
     "ONE DASH IN THE AIR. LAND OR TOUCH AN EMBER TO GET IT BACK."],
    ["THE WOODS ARE QUIET. TOO QUIET. EVEN THE BIRDS HAVE GONE.",
     "SOMEONE HAS LEFT RED SPRINGS ALL OVER THE PATH. WHO WOULD DO THAT?",
     "RED SPRINGS THROW YOU HIGH. JUMP AT A WALL IN THE AIR TO KICK OFF IT.",
     "SANDY BLOCKS CRUMBLE WHEN YOU STAND ON THEM. DO NOT WAIT AROUND.",
     "CRACKED ICE SHATTERS WHEN YOU HIT IT. IN THE AIR. HOLD S AND CLICK TO GROUND POUND."],
    ["THE PATH DIVES UNDER THE ICE. IT IS SO COLD THAT PIPS BREATH HANGS IN THE AIR.",
     "A VOICE ECHOES IN THE DARK: WHO GOES THERE?",
     "A SNOWY OWL DROPS DOWN. WREN: A TRAVELLER? UP HERE? YOU MUST BE AFTER THE SHARDS.",
     "WREN: FOUR OF THEM FELL DEEP INTO THE ICE. I WILL SHOW YOU THE WAY.",
     "WREN: MIND THE CEILING. THE ICE HAS TEETH.",
     "WREN: ICE BATS SWOOP WHEN YOU GET CLOSE. PRESS E TO THROW AN EMBER BOLT."],
    ["WREN: THESE ARE THE ICE FALLS. THE FLOOR IS AS SLICK AS GLASS.",
     "WREN: YOU WILL SLIDE. START RUNNING EARLY. STOP EARLY.",
     "WREN: AND LISTEN FOR CRACKING ABOVE YOU.",
     "WREN: ICICLES FALL WHEN SOMETHING WARM WALKS UNDER THEM.",
     "PIP: SOMETHING WARM?",
     "WREN: YOU. KEEP MOVING.",
     "WREN: SNOW SPRITES POP WITH ONE SWING. LEFT CLICK. CLICK THREE TIMES FAST FOR A COMBO."],
    ["WREN: THE CRYSTAL HOLLOW. THE HEARTS WARMTH STILL FLOATS HERE AS EMBERS.",
     "WREN: THERE IS NO FLOOR HERE. ONLY SPIKES.",
     "WREN: YOU WILL HAVE TO FLY FROM EMBER TO EMBER.",
     "PIP: I CAN NOT FLY.",
     "WREN: YOU CAN DASH. AND EVERY EMBER GIVES IT BACK. THAT IS CLOSE ENOUGH.",
     "WREN: DO NOT LOOK DOWN."],
    ["THE HOLLOW OPENS ONTO A GLACIER. FAR ABOVE. THE SUMMIT GLOWS GREEN.",
     "WREN: PIP. I HAVE TO TELL YOU SOMETHING. THE HEART DID NOT CRACK BY ITSELF.",
     "WREN: THE MOUNTAIN WAS LONELY. EVERY YEAR THE VALLEY TOOK ITS SPRING...",
     "WREN: ...AND NOBODY EVER CLIMBED UP TO SAY THANK YOU.",
     "WREN: SO IT BROKE ITS OWN HEART...",
     "WREN: ...AND HID THE PIECES WHERE ONLY SOMEONE WHO CARED WOULD GO.",
     "PIP: THEN I WILL GO ALL THE WAY UP. AND I WILL SAY IT.",
     "WREN: ...AND SOMEONE IN THE VALLEY IS WAITING FOR YOU. YOU KEEP LOOKING BACK DOWN.",
     "PIP: NO I DO NOT.",
     "WREN: HOO. YOU ARE DOING IT RIGHT NOW.",
     "WREN: THEN HURRY. THE GLACIER IS CRACKING."],
    ["THE SUMMIT. THE WIND IS LOUD AND THE SNOW IS DEEP. ANOTHER SHARD SHINES ABOVE.",
     "WREN: I CAN NOT FLY IN THIS WIND. FROM HERE YOU GO ALONE.",
     "BRAM (VERY FAR BELOW): GO ON. PIP!",
     "ONE MORE CLIMB."],
    ["PIP REACHES THE TOP. THE LAST SHARD SHOULD BE HERE. BUT THE SNOW IS EMPTY.",
     "THEN THE FOG MOVES. TWO RED EYES OPEN IN THE WHITE.",
     "A YETI AS BIG AS A HOUSE. AND IN ITS FOREHEAD... THE LAST SHARD. GLOWING.",
     "WREN (FAR AWAY): PIP! THE SHARD HAS MADE IT WILD!",
     "WREN: FREE THE SHARD AND YOU FREE THE YETI!",
     "WHEN IT FALLS OR CRASHES INTO A WALL IT IS DIZZY. THAT IS WHEN YOU STRIKE.",
     "SWING. STOMP. DASH INTO IT. EMBER BOLTS CAN EVEN STOP IT MID ATTACK.",
     "IT GETS ANGRIER AS IT GETS HURT. WATCH FOR ITS ICE BREATH."]
]
var RUN = [2, 3, 4, 3]
var BERRIES = BERRY_TOTAL
var W = 48
var H = 16
var SW = 228          // the screen is wide (widescreen): 228 x 128
var OX = 50           // how far to shift things drawn for a 128-wide screen to centre them

var mode = "title"
var level = 0
var lines = []
var freeze = 0
var levelTime = 0
var px = 0
var py = 0
var vx = 0
var vy = 0
var facing = 1
var grounded = false
var wall = 0
var coyote = 0
var buffer = 0
var canDash = true
var dashTime = 0
var wallLock = 0
var lastJump = -1
var steps = 0
var dead = 0
var won = 0
var shards = 0
var berries = 0
var deaths = 0
var startTime = 0
var finishTime = 0
var broken = []
var crystals = []
var springs = []
var icicles = []
// wall crystals: grab one and Pip runs straight up the next wall he touches
var wallGems = []
var wallCharge = false
var wallRun = 0
// the Complete Edition: the mountain, enemies and combat
var hubPX = -1
var hubPY = 0
var done = []
var seen = []
var enemies = []
var enemySpawns = []
var smashed = []
var bolts = []
var combo = 0
var lastSwing = -1
var pounding = false
var shootCool = 0
var camy = 0
var scarf = []
var snow = []

func init() {
    widescreen(true)
    cartdata("pip")
    loadSettings()
    startMusic()
    var i = 0
    while i < 5 {
        push(scarf, {"x": 0, "y": 0})
        i += 1
    }
    i = 0
    while i < 40 {
        push(snow, {"x": rnd(228), "y": rnd(128), "s": 0.3 + rnd(0.7)})
        i += 1
    }
}

// ---------- the map ----------

func tileAt(x, y) {
    var tx = flr(x / 8)
    var ty = flr(y / 8)
    if tx < 0 or tx >= W { return 64 }
    if ty < 0 or ty >= H { return 0 }
    var L = LEVELS[level]
    return mget(L["x"] + tx, L["y"] + ty)
}
func flagAt(x, y, f) { return fget(tileAt(x, y), f) }
func solidAt(x, y) { return fget(tileAt(x, y), 0) }
func setTile(tx, ty, n) {
    var L = LEVELS[level]
    mset(L["x"] + tx, L["y"] + ty, n)
}

// Pip's body is a box 6 wide and 12 tall, from (px, py)
func hitsSolid(x, y) {
    return solidAt(x, y) or solidAt(x + 5, y) or solidAt(x, y + 6) or solidAt(x + 5, y + 6) or solidAt(x, y + 11) or solidAt(x + 5, y + 11)
}
// a tile with this flag that Pip touches (a little inside the box, so spikes are fair), or none
func touched(f) {
    for c in [[1, 2], [4, 2], [1, 10], [4, 10], [2, 6]] {
        var x = px + c[0]
        var y = py + c[1]
        if flagAt(x, y, f) { return {"x": flr(x / 8), "y": flr(y / 8)} }
    }
    return none
}
// the same, for a tile with no flag of its own (the flags are all used up)
func touchedTile(n) {
    for c in [[1, 2], [4, 2], [1, 10], [4, 10], [2, 6]] {
        var x = px + c[0]
        var y = py + c[1]
        if tileAt(x, y) == n { return {"x": flr(x / 8), "y": flr(y / 8)} }
    }
    return none
}

// ---------- levels ----------

func startGame() {
    shards = 0
    berries = 0
    deaths = 0
    done = []
    seen = []
    hubPX = -1
    level = 0
    mode = "play"
    startTime = t()
    startLevel()
    lines = copy(INTRO)
    for s in STORY[0] { push(lines, s) }
}

func isHub() { return level == HUB }

// leaves a level for the mountain, standing where Pip went in
func returnToHub() {
    resetTiles()
    level = HUB
    startLevel()
    for g in GATES {
        if shards == g["need"] and len(lines) == 0 {
            lines = ["AN ICE GATE MELTS SOMEWHERE ON THE MOUNTAIN!"]
        }
    }
}

// the door Pip is standing in front of, or none
func doorHere() {
    for d in DOORS {
        if abs(d["x"] * 8 + 4 - (px + 3)) < 7 and abs((d["y"] + 1) * 8 - (py + 12)) < 3 { return d }
    }
    return none
}

func enterDoor(d) {
    if d["level"] == BOSS and shards < TOTAL - 1 {
        if len(lines) == 0 { lines = ["THE YETI WAITS BEYOND THIS DOOR. FIND EVERY OTHER SHARD FIRST."] }
        return
    }
    hubPX = d["x"] * 8 + 1
    hubPY = (d["y"] + 1) * 8 - 12
    resetTiles()
    level = d["level"]
    startLevel()
    play(5)
    if not contains(seen, level) {
        push(seen, level)
        lines = copy(STORY[level])
    }
}

// puts back the crumbled blocks, used crystals and springs of this level
func resetTiles() {
    for b in broken { setTile(b["x"], b["y"], 102) }
    for c in crystals { setTile(c["x"], c["y"], 107) }
    for c in wallGems { setTile(c["x"], c["y"], 161) }
    for s in springs { setTile(s["x"], s["y"], 100) }
    for i in icicles { setTile(i["x"], i["y"], 144) }
    for e in enemySpawns { setTile(e["x"], e["y"], e["tile"]) }
    for s in smashed { setTile(s["x"], s["y"], 153) }
    enemySpawns = []
    smashed = []
    enemies = []
    bolts = []
    corpses = []
    sparks = []
    pops = []
    streak = 0
    broken = []
    crystals = []
    wallGems = []
    springs = []
    icicles = []
}

func startLevel() {
    resetTiles()
    var L = LEVELS[level]
    W = 48
    if has(L, "w") { W = L["w"] }
    H = 16
    if has(L, "h") { H = L["h"] }
    if isBoss() { initBoss() }
    if isHub() {
        for g in GATES { setTile(g["x"], g["y"], shards >= g["need"] ? 0 : 152) }
    }
    // find the icicles that can fall
    var ty = 0
    while ty < H {
        var tx = 0
        while tx < W {
            var here = mget(L["x"] + tx, L["y"] + ty)
            if here == 144 { push(icicles, {"x": tx, "y": ty, "state": 0, "t": 0, "fy": ty * 8, "v": 0}) }
            if here == 156 or here == 158 {
                // enemies: their marker tiles come off the map while they're out walking and flying
                push(enemySpawns, {"x": tx, "y": ty, "tile": here})
                push(enemies, {"kind": here == 156 ? "walker" : "bat", "x": tx * 8, "y": ty * 8, "hx": tx * 8, "hy": ty * 8, "vx": 0.4, "t": rnd(60), "alive": true})
                setTile(tx, ty, 0)
            }
            tx += 1
        }
        ty += 1
    }
    px = L["sx"] * 8 + 1
    py = L["sy"] * 8 - 12
    if isHub() and hubPX >= 0 {
        px = hubPX
        py = hubPY
    }
    pounding = false
    vx = 0
    vy = 0
    facing = 1
    canDash = true
    dashTime = 0
    wallLock = 0
    wallCharge = false
    wallRun = 0
    dead = 0
    levelTime = 0
    for s in scarf {
        s["x"] = px
        s["y"] = py + 5
    }
}

func nextLevel() {
    resetTiles()
    level += 1
    if level >= len(LEVELS) {
        level = len(LEVELS) - 1
        mode = "epilogue"
        page = 0
        pageTime = 0
        finishTime = t() - startTime
        if dget(0) == 0 or finishTime < dget(0) { dset(0, finishTime) }
        return
    }
    startLevel()
    lines = copy(STORY[level])
}

func die() {
    if dead > 0 { return }
    if god {
        // never die: bounce back out of pits instead
        if py > H * 8 - 16 {
            py = H * 8 - 24
            vy = -6
            canDash = true
        }
        return
    }
    burst(px + 3, py + 6, 24, 8, 1.6)
    burst(px + 3, py + 6, 10, 7, 1)
    shake(5)
    play(4)
    deaths += 1
    dead = 30
}

// ---------- every frame ----------

func update() {
    if mode == "settings" {
        updateSettings()
        return
    }
    if mode == "cheats" {
        updateCheats()
        return
    }
    if mode == "title" {
        if keyp("p") {
            openSettings("title")
            return
        }
        if keyp("f1") {
            openCheats("title")
            return
        }
        updateTitle()
        return
    }
    // story boxes, one at a time; the game waits while one is open
    if saying() { return }
    if len(lines) > 0 {
        say(remove(lines, 0))
        freeze = 8
        return
    }
    if mode == "epilogue" {
        updateEpilogue()
        return
    }
    if mode == "end" {
        if freeze > 0 {
            freeze -= 1
            return
        }
        if btnp(4) or keyp("space") { mode = "title" }
        return
    }
    if freeze > 0 {
        freeze -= 1
        return
    }
    if flash > 0 { flash -= 1 }
    if hitstop > 0 {
        hitstop -= 1
        return
    }
    levelTime += 1
    updateTiles()
    if won > 0 {
        won -= 1
        if won == 0 { nextLevel() }   // (after the yeti, the last level: the ending)
        return
    }
    if dead > 0 {
        dead -= 1
        if dead == 0 { startLevel() }
        return
    }
    if keyp("r") {
        die()
        return
    }
    if keyp("p") {
        openSettings("play")
        return
    }
    if keyp("f1") {
        openCheats("play")
        return
    }
    if isHub() {
        var n = npcHere()
        if n != none and (btnp(3) or hit("down")) and grounded {
            lines = npcTalk(n)
            return
        }
        var d = doorHere()
        if d != none and (btnp(3) or hit("down")) and grounded {
            enterDoor(d)
            return
        }
    }
    updatePip()
    updateEnemies()
    updateBolts()
    updateHitFx()
    if isBoss() { updateBoss() }
}

func updateTiles() {
    for b in broken {
        if b["t"] > 0 {
            b["t"] -= 1
            if b["t"] == 0 {
                setTile(b["x"], b["y"], 0)
                burst(b["x"] * 8 + 4, b["y"] * 8 + 4, 8, 9, 0.8)
                b["back"] = 140
            }
        } else if b["back"] > 0 {
            b["back"] -= 1
            if b["back"] == 0 {
                // grow back, unless Pip is standing in the way
                if abs(b["x"] * 8 + 4 - (px + 3)) < 8 and abs(b["y"] * 8 + 4 - (py + 6)) < 11 {
                    b["back"] = 10
                } else {
                    setTile(b["x"], b["y"], 102)
                }
            }
        }
    }
    for c in crystals {
        if c["t"] > 0 {
            c["t"] -= 1
            if c["t"] == 0 {
                setTile(c["x"], c["y"], 107)
                burst(c["x"] * 8 + 4, c["y"] * 8 + 3, 6, 14, 0.5)
            }
        }
    }
    for c in wallGems {
        if c["t"] > 0 {
            c["t"] -= 1
            if c["t"] == 0 {
                setTile(c["x"], c["y"], 161)
                burst(c["x"] * 8 + 4, c["y"] * 8 + 3, 6, 11, 0.5)
            }
        }
    }
    updateIcicles()
    for s in springs {
        if s["t"] > 0 {
            s["t"] -= 1
            if s["t"] == 0 { setTile(s["x"], s["y"], 100) }
        }
    }
}

// icicles: shake when Pip passes under, then fall; they shatter on the ground
func updateIcicles() {
    for i in icicles {
        var ix = i["x"] * 8
        if i["state"] == 0 and dead == 0 and px + 6 > ix - 6 and px < ix + 14 and py > i["y"] * 8 {
            i["state"] = 1
            i["t"] = 14
        } else if i["state"] == 1 {
            i["t"] -= 1
            if i["t"] == 0 {
                i["state"] = 2
                setTile(i["x"], i["y"], 0)
            }
        } else if i["state"] == 2 {
            i["v"] = min(i["v"] + 0.3, 5)
            i["fy"] += i["v"]
            if dead == 0 and abs(ix + 4 - (px + 3)) < 6 and i["fy"] + 7 > py and i["fy"] < py + 12 { die() }
            if solidAt(ix + 4, i["fy"] + 8) or i["fy"] > H * 8 {
                i["state"] = 3
                burst(ix + 4, i["fy"] + 6, 10, 7, 1)
                burst(ix + 4, i["fy"] + 6, 6, 12, 0.8)
                play(4)
            }
        }
    }
}

func drawIcicles() {
    for i in icicles {
        if i["state"] == 1 { spr(144, i["x"] * 8 + rnd(2) - 1, i["y"] * 8) }
        if i["state"] == 2 { spr(144, i["x"] * 8, i["fy"]) }
    }
}

func crumble(tx, ty) {
    if tileAt(tx * 8, ty * 8) != 102 { return }
    setTile(tx, ty, 103)
    push(broken, {"x": tx, "y": ty, "t": 18, "back": 0})
}

func onLedge() {
    var feet = py + 12
    if feet - flr(feet / 8) * 8 > 1 { return false }
    return flagAt(px, feet, 6) or flagAt(px + 5, feet, 6)
}

func updatePip() {
    var dx = 0
    if btn(0) or held("left") { dx = -1 }
    if btn(1) or held("right") { dx = 1 }
    var jumpHeld = btn(4) or btn(2) or held("jump")
    var dashPressed = btnp(5) or hit("dash")
    if btnp(4) or btnp(2) or hit("jump") { buffer = 6 }
    // left click: swing
    if atkCool > 0 { atkCool -= 1 }
    if atkTime > 0 { atkTime -= 1 }
    if shootCool > 0 { shootCool -= 1 }
    if hit("swing") and atkCool == 0 {
        if not grounded and not pounding and (btn(3) or held("down")) {
            // ground pound: straight down, hard
            pounding = true
            dashTime = 0
            vx = 0
            vy = 5
            play(1)
        } else if not pounding {
            // a three hit combo: click again quickly to keep it going; the third hit lunges and hits hardest
            combo = t() - lastSwing < 0.5 ? combo % 3 + 1 : 1
            lastSwing = t()
            atkTime = 8
            atkCool = combo == 3 ? 18 : 9
            if combo == 3 {
                vx = facing * 2.5
                shake(2)
            }
            play(2)
            burst(px + 3 + facing * 9, py + 6, 4, combo == 3 ? 10 : 7, 0.8)
            swingHits(combo == 3 ? 14 : 10)
            if isBoss() { strike(combo == 3 ? 2 : 1) }
        }
    }
    if hit("shoot") and shootCool == 0 {
        push(bolts, {"x": px + 3 + facing * 6, "y": py + 5, "vx": facing * 4, "life": 70})
        shootCool = 24
        play(1)
    }

    grounded = vy >= 0 and (solidAt(px, py + 12) or solidAt(px + 5, py + 12) or onLedge())
    if grounded {
        coyote = 6
        if dashTime == 0 { canDash = true }
    }
    if infDash and dashTime == 0 { canDash = true }
    if grounded {
        if flagAt(px + 1, py + 12, 7) { crumble(flr((px + 1) / 8), flr((py + 12) / 8)) }
        if flagAt(px + 4, py + 12, 7) { crumble(flr((px + 4) / 8), flr((py + 12) / 8)) }
    } else if coyote > 0 {
        coyote -= 1
    }
    wall = 0
    if not grounded {
        if hitsSolid(px + 1, py) {
            wall = 1
        } else if hitsSolid(px - 1, py) {
            wall = -1
        }
    }
    if grounded { wallRun = 0 }
    if wallCharge and wall != 0 and dashTime == 0 {
        // the wall crystal kicks in: up the wall
        wallCharge = false
        wallRun = 60
        facing = wall
        play(1)
        burst(px + 3, py + 6, 10, 11, 0.8)
    }

    // jumping: off the ground (a moment after leaving it still counts), or off a wall
    if buffer > 0 and dashTime == 0 {
        if coyote > 0 {
            vy = -3.2
            buffer = 0
            coyote = 0
            play(0)
            burst(px + 3, py + 12, 5, 6, 0.6)
        } else if wall != 0 {
            vy = -3.0
            vx = -wall * 2.2
            facing = -wall
            wallLock = 10
            wallRun = 0
            buffer = 0
            play(0)
            burst(px + 3 + wall * 3, py + 8, 5, 6, 0.6)
        }
    }
    if buffer > 0 { buffer -= 1 }

    // dashing
    if dashPressed and canDash {
        var ddx = dx
        var ddy = 0
        if btn(2) or held("jump") { ddy = -1 }
        if btn(3) or held("down") { ddy = 1 }
        if ddx == 0 and ddy == 0 { ddx = facing }
        var speed = 3.4
        if ddx != 0 and ddy != 0 { speed = 2.6 }
        vx = ddx * speed
        vy = ddy * speed
        if ddx != 0 { facing = ddx }
        dashTime = 9
        canDash = false
        wallLock = 0
        wallRun = 0
        shake(2)
        play(1)
        burst(px + 3, py + 6, 8, 9, 1)
    }

    if dashTime > 0 {
        dashTime -= 1
        if dashTime % 2 == 0 { burst(px + 3, py + 6, 2, pick([9, 10]), 0.3) }
        if dashTime == 0 {
            vx = vx * 0.5
            vy = vy * 0.5
        }
    } else if wallRun > 0 {
        // running up the wall; over the top, a little hop on to it
        wallRun -= 1
        vy = -2.4
        vx = wall * 0.5
        if wallRun % 3 == 0 { burst(px + 3 + wall * 3, py + 11, 1, 11, 0.3) }
        if wall == 0 {
            wallRun = 0
            vy = -1.8
            vx = facing * 1.2
        }
    } else {
        if dx != 0 and wallLock == 0 { facing = dx }
        if wallLock > 0 {
            wallLock -= 1
        } else {
            var grip = 0.18
            if grounded { grip = 0.35 }
            var under = tileAt(px + 3, py + 12)
            if grounded and under >= 128 and under < 144 { grip = 0.035 }   // ice: slow to start, slow to stop
            vx += (dx * 1.4 - vx) * grip
        }
        var g = 0.2
        if abs(vy) < 0.6 and jumpHeld { g = 0.1 }
        if vy < 0 and not jumpHeld { g = 0.4 }
        vy += g
        if wall != 0 and dx == wall and vy > 0.8 { vy = 0.8 }
        vy = min(vy, 3.6)
    }

    if pounding {
        vx = 0
        vy = 5
        dashTime = 0
    }
    if moveX(vx) { vx = 0 }
    moveY(vy)
    if pounding and vy == 0 { poundLand() }

    if grounded and abs(vx) > 0.3 { steps += 1 } else { steps = 0 }

    // what Pip touches
    if touched(1) != none or py > H * 8 {
        die()
        return
    }
    var s = touched(4)
    if s != none and vy >= 0 {
        vy = -5.4
        dashTime = 0
        canDash = true
        coyote = 0
        setTile(s["x"], s["y"], 101)
        push(springs, {"x": s["x"], "y": s["y"], "t": 10})
        play(0)
        burst(s["x"] * 8 + 4, s["y"] * 8 + 4, 6, 8, 0.8)
        shake(1)
    }
    var c = touched(5)
    if c != none and not canDash {
        canDash = true
        setTile(c["x"], c["y"], 108)
        push(crystals, {"x": c["x"], "y": c["y"], "t": 150})
        play(3)
        burst(c["x"] * 8 + 4, c["y"] * 8 + 3, 10, 14, 1)
    }
    var wg = touchedTile(161)
    if wg != none and not wallCharge and wallRun == 0 {
        wallCharge = true
        setTile(wg["x"], wg["y"], 162)
        push(wallGems, {"x": wg["x"], "y": wg["y"], "t": 120})
        play(3)
        burst(wg["x"] * 8 + 4, wg["y"] * 8 + 3, 10, 11, 1)
    }
    var b = touched(2)
    if b != none {
        setTile(b["x"], b["y"], 0)
        berries += 1
        play(3)
        burst(b["x"] * 8 + 4, b["y"] * 8 + 4, 10, 10, 1)
    }
    var gem = touched(3)
    if gem != none {
        setTile(gem["x"], gem["y"], 0)
        shards += 1
        play(5)
        shake(3)
        burst(gem["x"] * 8 + 4, gem["y"] * 8 + 4, 30, 11, 1.5)
        burst(gem["x"] * 8 + 4, gem["y"] * 8 + 4, 15, 7, 1)
        won = 60
    }

    // the scarf: each piece follows the one before, blowing back
    var hx = px + 3 - facing * 2
    var hy = py + 6
    for p in scarf {
        p["x"] += (hx - p["x"]) * 0.45
        p["y"] += (hy - p["y"]) * 0.45
        hx = p["x"] - facing * 1.2
        hy = p["y"] + 0.4 + sin(t() * 9 + hx) * 0.3
    }
}

// ---------- combat ----------

// a cracked ice tile at this spot shatters
func smashAt(x, y) {
    if tileAt(x, y) != 153 { return false }
    var tx = flr(x / 8)
    var ty = flr(y / 8)
    setTile(tx, ty, 0)
    push(smashed, {"x": tx, "y": ty})
    burst(tx * 8 + 4, ty * 8 + 4, 12, 12, 1.2)
    burst(tx * 8 + 4, ty * 8 + 4, 6, 7, 0.8)
    play(4)
    return true
}

// the sword's reach: enemies and cracked ice in front of Pip
func swingHits(reach) {
    var x0 = px + 3
    var x1 = px + 3 + facing * reach
    for e in enemies {
        var ex = e["x"] + 4
        if e["alive"] and (ex - x0) * facing > -3 and (ex - x1) * facing < 4 and abs(e["y"] + 4 - (py + 6)) < 12 { killEnemy(e) }
    }
    var k = 4
    while k <= reach {
        smashAt(px + 3 + facing * k, py + 2)
        smashAt(px + 3 + facing * k, py + 10)
        k += 4
    }
}

func poundLand() {
    pounding = false
    shake(5)
    play(4)
    burst(px + 3, py + 12, 20, 7, 1.6)
    burst(px + 3, py + 12, 10, 6, 1)
    var hit = false
    for dxs in [-6, 1, 4, 11] {
        if smashAt(px + dxs, py + 13) { hit = true }
    }
    for e in enemies {
        if e["alive"] and abs(e["x"] + 4 - (px + 3)) < 22 and abs(e["y"] + 4 - (py + 8)) < 14 { killEnemy(e) }
    }
    if isBoss() and bstate == "stunned" and abs(headX() - (px + 3)) < 18 and abs(headY() - (py + 12)) < 18 { hurtBoss(2) }
    vy = hit ? 1 : -1.5   // a little bounce off solid ground
}

// ---------- what a hit feels like: a freeze, a white flash, knockback, a star, and a combo count ----------
var corpses = []
var sparks = []
var pops = []
var streak = 0
var streakTime = 0

func killEnemy(e) {
    e["alive"] = false
    var away = sign(e["x"] + 4 - (px + 3))
    if away == 0 { away = facing }
    var big = combo == 3 and atkTime > 0
    hitstop = max(hitstop, big ? 7 : 4)
    shake(big ? 3 : 2)
    play(4)
    // it flies off backwards, flashing, and pops a moment later
    push(corpses, {"x": e["x"], "y": e["y"], "vx": away * (big ? 3 : 2.2), "vy": -2.6, "t": 24,
                   "s": e["kind"] == "bat" ? 158 : 156, "flip": away < 0, "c": e["kind"] == "bat" ? 12 : 7})
    push(sparks, {"x": e["x"] + 4, "y": e["y"] + 4, "t": 6})
    // kills close together count up
    streak = streakTime > 0 ? streak + 1 : 1
    streakTime = 90
    if streak > 1 { push(pops, {"x": e["x"] + 4, "y": e["y"] - 4, "t": 40, "text": "X" + streak + "!"}) }
    canDash = true     // hitting things gives the dash back
}

func updateHitFx() {
    for c in corpses {
        c["x"] += c["vx"]
        c["y"] += c["vy"]
        c["vy"] += 0.3
        c["vx"] *= 0.95
        c["t"] -= 1
        if c["t"] == 0 {
            burst(c["x"] + 4, c["y"] + 4, 14, c["c"], 1.3)
            burst(c["x"] + 4, c["y"] + 4, 6, 7, 0.8)
        }
    }
    corpses = filter(corpses, func(c) { return c["t"] > 0 })
    for s in sparks { s["t"] -= 1 }
    sparks = filter(sparks, func(s) { return s["t"] > 0 })
    for p in pops {
        p["y"] -= 0.4
        p["t"] -= 1
    }
    pops = filter(pops, func(p) { return p["t"] > 0 })
    if streakTime > 0 { streakTime -= 1 }
}

func drawHitFx() {
    for c in corpses {
        if c["t"] > 18 {
            var k = 1
            while k < 16 {          // all white for the first few frames
                pal(k, 7)
                k += 1
            }
            spr(c["s"], c["x"], c["y"], 1, 1, c["flip"])
            pal()
        } else if c["t"] % 4 < 2 {
            spr(c["s"], c["x"], c["y"], 1, 1, c["flip"])
        }
    }
    for s in sparks {
        // an impact star, opening out
        var r = 8 - s["t"]
        line(s["x"] - r, s["y"], s["x"] + r, s["y"], 7)
        line(s["x"], s["y"] - r, s["x"], s["y"] + r, 7)
        line(s["x"] - r / 2, s["y"] - r / 2, s["x"] + r / 2, s["y"] + r / 2, 10)
        line(s["x"] - r / 2, s["y"] + r / 2, s["x"] + r / 2, s["y"] - r / 2, 10)
    }
    for p in pops {
        var x = p["x"] - len(p["text"]) * 2
        print(p["text"], x + 1, p["y"] + 1, 1)
        print(p["text"], x, p["y"], flr(p["t"] / 3) % 2 == 0 ? 10 : 7)
    }
}

func updateEnemies() {
    for e in enemies {
        if not e["alive"] { continue }
        e["t"] += 1
        if e["kind"] == "walker" {
            // walks along, turning at walls and edges
            var nx = e["x"] + e["vx"]
            var ahead = e["vx"] > 0 ? nx + 8 : nx - 1
            if solidAt(ahead, e["y"] + 4) or not solidAt(ahead, e["y"] + 9) {
                e["vx"] = -e["vx"]
            } else {
                e["x"] = nx
            }
        } else {
            // bats: bob around home; swoop at Pip when close
            var dx = px + 3 - (e["x"] + 4)
            var dy = py + 6 - (e["y"] + 4)
            if abs(dx) < 44 and abs(dy) < 40 and dead == 0 {
                e["x"] += sign(dx) * 0.55
                e["y"] += sign(dy) * 0.45
            } else {
                e["x"] += (e["hx"] - e["x"]) * 0.03
                e["y"] += (e["hy"] + sin(e["t"] * 0.08) * 6 - e["y"]) * 0.1
            }
        }
        if dead == 0 and abs(e["x"] + 4 - (px + 3)) < 7 and abs(e["y"] + 4 - (py + 6)) < 9 {
            if pounding {
                // a pogo: pounding on to an enemy bounces Pip back up, dash and all
                killEnemy(e)
                pounding = false
                vy = -4.2
                canDash = true
                burst(px + 3, py + 12, 8, 7, 1)
            } else if dashTime > 0 {
                killEnemy(e)
            } else {
                die()
            }
        }
    }
}

func updateBolts() {
    for b in bolts {
        b["x"] += b["vx"]
        b["life"] -= 1
        if b["life"] % 2 == 0 { burst(b["x"], b["y"], 1, pick([9, 10]), 0.3) }
        if solidAt(b["x"], b["y"]) {
            smashAt(b["x"], b["y"])
            burst(b["x"], b["y"], 6, 9, 0.8)
            b["life"] = 0
        }
        for e in enemies {
            if e["alive"] and b["life"] > 0 and abs(e["x"] + 4 - b["x"]) < 6 and abs(e["y"] + 4 - b["y"]) < 6 {
                killEnemy(e)
                b["life"] = 0
            }
        }
        if isBoss() and b["life"] > 0 and abs(b["x"] - headX()) < 12 and abs(b["y"] - headY()) < 14 {
            boltHitBoss()
            b["life"] = 0
        }
    }
    bolts = filter(bolts, func(b) { return b["life"] > 0 })
}

func drawEnemies() {
    for e in enemies {
        if not e["alive"] { continue }
        if e["kind"] == "walker" {
            spr(156 + flr(e["t"] / 10) % 2, e["x"], e["y"], 1, 1, e["vx"] < 0)
        } else {
            spr(158 + flr(e["t"] / 6) % 2, e["x"], e["y"])
        }
    }
    for b in bolts { spr(160, b["x"] - 4, b["y"] - 3, 1, 1, b["vx"] < 0) }
    drawHitFx()
}

// the mountain's doors: the level's name and S when Pip is in front, a shard over finished ones, locks
func drawDoors() {
    if not isHub() { return }
    var here = doorHere()
    for d in DOORS {
        var x = d["x"] * 8
        var y = d["y"] * 8
        if contains(done, d["level"]) { spr(109, x, y - 18 + sin(t() * 3 + x) * 1.5) }
        if d["level"] == BOSS and shards < TOTAL - 1 {
            rectfill(x + 2, y - 4, x + 5, y - 1, 5)
            rect(x + 1, y - 7, x + 6, y - 3, 6)
        }
        if here == d {
            var name = LEVELS[d["level"]]["name"]
            rectfill(x + 4 - len(name) * 2 - 2, y - 30, x + 4 + len(name) * 2, y - 22, 1)
            print(name, x + 4 - len(name) * 2, y - 28, 7)
            if flr(t() * 3) % 2 == 0 { print("S", x + 2, y - 16, 10) }
        }
    }
    // gates say how many shards they need
    for g in GATES {
        if shards < g["need"] and abs(g["x"] * 8 + 4 - (px + 3)) < 26 and abs(g["y"] * 8 - py) < 26 {
            var msg = "NEEDS " + g["need"] + " SHARDS"
            rectfill(g["x"] * 8 + 4 - len(msg) * 2 - 2, g["y"] * 8 - 12, g["x"] * 8 + 4 + len(msg) * 2, g["y"] * 8 - 4, 1)
            print(msg, g["x"] * 8 + 4 - len(msg) * 2, g["y"] * 8 - 10, 12)
            break
        }
    }
}

func moveX(amount) {
    var nx = px + amount
    if not hitsSolid(nx, py) {
        px = nx
        return false
    }
    var s = sign(amount)
    var guard = 0
    while not hitsSolid(px + s, py) and guard < 8 {
        px += s
        guard += 1
    }
    return true
}

func moveY(amount) {
    // ledges hold Pip only when coming down onto them (hold down to drop through)
    if amount > 0 and not (btn(3) or held("down")) {
        var feet = py + 12
        var after = feet + amount
        var top = flr(after / 8) * 8
        if feet <= top and after >= top and (flagAt(px, after, 6) or flagAt(px + 5, after, 6)) {
            py = top - 12
            vy = 0
            return
        }
    }
    var ny = py + amount
    if not hitsSolid(px, ny) {
        py = ny
        return
    }
    var s = sign(amount)
    var guard = 0
    while not hitsSolid(px, py + s) and guard < 8 {
        py += s
        guard += 1
    }
    if s > 0 { py = flr((py + 13) / 8) * 8 - 12 }
    vy = 0
}

// ---------- settings ----------

var KEYS = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z", "space", "enter", "shift", "up", "down", "left", "right", "click"]
var ACTIONS = [["LEFT", "left"], ["RIGHT", "right"], ["JUMP", "jump"], ["DOWN", "down"], ["DASH", "dash"], ["SWING", "swing"], ["EMBER BOLT", "shoot"]]
var binds = {"left": "a", "right": "d", "jump": "w", "down": "s", "dash": "q", "swing": "click", "shoot": "e"}
var musicOn = true
var sfxOn = true
var menu = 0
var waiting = false
var backTo = "title"

// cartdata slots: 0 best time, 1-7 keys, 9 music off, 10 sound off
func loadSettings() {
    var i = 0
    while i < len(ACTIONS) {
        var v = dget(i + 1)
        if v > 0 and v <= len(KEYS) { binds[ACTIONS[i][1]] = KEYS[v - 1] }
        i += 1
    }
    musicOn = dget(9) == 0
    sfxOn = dget(10) == 0
}

func saveSettings() {
    var i = 0
    while i < len(ACTIONS) {
        dset(i + 1, indexOf(KEYS, binds[ACTIONS[i][1]]) + 1)
        i += 1
    }
    dset(9, musicOn ? 0 : 1)
    dset(10, sfxOn ? 0 : 1)
}

func play(n) {
    if sfxOn { sfx(n) }
}

func startMusic() {
    if musicOn { music(0) } else { music(-1) }
}

// the player's keys (a key name, or "click" for the left mouse button)
func held(a) {
    var k = binds[a]
    if k == "click" { return mousedown() }
    return key(k)
}
func hit(a) {
    var k = binds[a]
    if k == "click" { return click() }
    return keyp(k)
}

func openSettings(from) {
    backTo = from
    mode = "settings"
    menu = 0
    waiting = false
}

func updateSettings() {
    if waiting {
        // the next key (or click) pressed becomes the new key
        for k in KEYS {
            if k == "click" {
                if click() {
                    bindTo(k)
                    return
                }
            } else if keyp(k) {
                bindTo(k)
                return
            }
        }
        return
    }
    if btnp(2) { menu = (menu + 9) % 10 }
    if btnp(3) { menu = (menu + 1) % 10 }
    var my = mousey()
    if click() and mousex() - OX > 8 and mousex() - OX < 120 {
        var row = 0
        while row < 10 {
            var ry = settingsRowY(row)
            if my >= ry - 2 and my < ry + 7 {
                menu = row
                choose()
                return
            }
            row += 1
        }
    }
    if keyp("enter") or btnp(4) { choose() }
    if keyp("p") {
        mode = backTo
        freeze = 6
    }
}

// where each settings row sits: 7 keys, then music and sound, then back
func settingsRowY(i) {
    var y = 21 + i * 8
    if i >= 7 { y += 4 }
    if i == 9 { y += 3 }
    return y
}

func choose() {
    if menu < 7 {
        waiting = true
    } else if menu == 7 {
        musicOn = not musicOn
        startMusic()
        saveSettings()
    } else if menu == 8 {
        sfxOn = not sfxOn
        saveSettings()
        play(3)
    } else {
        mode = backTo
        freeze = 6
    }
}

func bindTo(k) {
    binds[ACTIONS[menu][1]] = k
    waiting = false
    saveSettings()
    play(3)
}

func drawSettings() {
    cls(1)
    menuCard("SETTINGS")
    var i = 0
    while i < 10 {
        var y = settingsRowY(i)
        var label = "BACK"
        var value = ""
        if i < 7 {
            label = ACTIONS[i][0]
            value = upper(binds[ACTIONS[i][1]])
            if waiting and menu == i { value = "PRESS..." }
        } else if i == 7 {
            label = "MUSIC"
            value = musicOn ? "ON" : "OFF"
        } else if i == 8 {
            label = "SOUND"
            value = sfxOn ? "ON" : "OFF"
        }
        menuRow(i == menu, label, value, y)
        i += 1
    }
    print("ENTER / CLICK    P: BACK", 18, 116, 5)
}

// ---------- the epilogue: storybook pages in a gold frame ----------

var EPILOGUE = [
    "THE YETI BLINKS. ITS EYES ARE GENTLE NOW. IT LOOKS CONFUSED. AND VERY FLUFFY.",
    "ALL NINE SHARDS CLICK TOGETHER IN PIPS HANDS. THE HEART BEATS ONCE.",
    "PIP: THANK YOU. MOUNTAIN. FOR EVERY SPRING.",
    "THE HEART BEATS AGAIN. LOUDER. THE SNOW AROUND PIP MELTS INTO WATER.",
    "WARMTH ROLLS DOWN THE SLOPES. THE GLACIER SIGHS. THE RIVERS START TO RUN.",
    "FAR BELOW. BRAM FEELS THE SUN ON HIS FACE. AND LAUGHS.",
    "WREN: YOU DID IT. AND THE MOUNTAIN HEARD YOU.",
    "THAT EVENING PIP WALKED DOWN TO THE WATERFALL. BRAE WAS WAITING. SHE HAD BEEN HOLDING SOMETHING ALL DAY.",
    "BRAE: TOOK YOU LONG ENOUGH. I WAS STARTING TO THINK THE YETI HAD KEPT YOU.",
    "A PINK FLOWER. THE FIRST OF THE SPRING. BRAE: I PICKED IT FOR YOU. IT MATCHES YOUR FACE WHEN YOU BLUSH.",
    "PIP STOOD THERE HOLDING THE FLOWER. RED TO THE EARS. HE COULD NOT THINK OF A SINGLE WORD.",
    "BRAE: SEE? JUST LIKE THAT.",
    "SO BRAE STOOD ON HER TIPTOES AND KISSED HIM. RIGHT THERE BY THE WATERFALL. IN THE LAST OF THE SUNLIGHT.",
    "THEN SHE WINKED. BRAE: THAT ONE WAS FOR SAVING SPRING. THE NEXT ONE YOU HAVE TO EARN.",
    "BRAE: AND I TOLD YOU. I HAVE A SOFT SPOT FOR GREEN.",
    "AND LATER...",
    "SPRING CAME BACK. THE FIELDS WENT GREEN AND THE RIVERS RAN LOUD.",
    "PIP AND BRAE SPENT THE WARM DAYS BY THE WATERFALL. TOGETHER.",
    "BRAM TOLD THE STORY TO ANYONE WHO WOULD SIT STILL LONG ENOUGH.",
    "THE YETI MOVED IN WITH WREN. TERRIBLE COOK. GREAT HUGGER.",
    "THE END."
]
var page = 0
var pageTime = 0

// splits text into lines of at most n letters
func wrap(text, n) {
    var out = []
    var line = ""
    for word in split(text, " ") {
        if len(line) > 0 and len(line) + 1 + len(word) > n {
            push(out, line)
            line = word
        } else if len(line) > 0 {
            line = line + " " + word
        } else {
            line = word
        }
    }
    if len(line) > 0 { push(out, line) }
    return out
}

func updateEpilogue() {
    pageTime += 1
    var full = len(EPILOGUE[page])
    var next = btnp(4) or btnp(5) or keyp("enter") or hit("jump") or hit("dash") or click()
    if pageTime > 10 and next {
        if pageTime * 0.7 < full {
            pageTime = flr(full / 0.7) + 1
        } else {
            page += 1
            pageTime = 0
            play(3)
            if page >= len(EPILOGUE) {
                mode = "end"
                freeze = 10
            }
        }
    }
}

func drawFrame() {
    rectfill(4, 4, 123, 123, 1)
    rect(4, 4, 123, 123, 9)
    rect(6, 6, 121, 121, 10)
    rect(8, 8, 119, 119, 4)
    // vines of little dots along the edges
    var i = 14
    while i < 114 {
        var w = sin(i * 0.3 + t()) * 1.5
        pset(i, 11 + w, 3)
        pset(i, 116 + w, 3)
        pset(11 + w, i, 3)
        pset(116 + w, i, 3)
        if i % 12 == 2 {
            pset(i, 11 + w, 11)
            pset(i, 116 + w, 11)
            pset(11 + w, i, 11)
            pset(116 + w, i, 11)
        }
        i += 3
    }
    // shards in the corners, gently bobbing
    var b = sin(t() * 2) * 1
    spr(109, 2, 2 + b)
    spr(109, 118, 2 - b)
    spr(109, 2, 118 - b)
    spr(109, 118, 118 + b)
}

func drawEpilogue() {
    cls(0)
    var last = len(EPILOGUE) - 1
    drawFrame()
    var text = EPILOGUE[page]
    var shown = flr(pageTime * 0.7)
    var rows = wrap(text, 24)
    var y = 64 - len(rows) * 4
    var count = 0
    for r in rows {
        var part = r
        if count + len(r) > shown { part = slice(r, 0, max(0, shown - count)) }
        if count < shown { print(part, 64 - len(r) * 2, y, page == 0 or page == last ? 10 : 7) }
        count += len(r) + 1
        y += 7
    }
}

// a filled circle kept inside the picture frame
func blob(cx, cy, r, c) {
    var dy = -r
    while dy <= r {
        var y = cy + dy
        if y >= 9 and y <= 118 {
            var hw = sqrt(r * r - dy * dy)
            line(max(9, cx - hw), y, min(118, cx + hw), y, c)
        }
        dy += 1
    }
}

// Pip and Brae by the waterfall
func drawWaterfall() {
    rectfill(9, 9, 118, 118, 12)
    circfill(30, 30, 8, 10)
    blob(40, 96, 40, 3)
    // cliff and the waterfall
    rectfill(76, 16, 118, 78, 5)
    rectfill(76, 16, 118, 18, 11)
    var x = 84
    while x <= 96 {
        line(x, 18, x, 76, 12)
        var y = (t() * 60 + x * 7) % 12
        while y < 58 {
            line(x, 18 + y, x, 21 + y, 7)
            y += 12
        }
        x += 1
    }
    rectfill(66, 76, 118, 82, 12)
    var f = 0
    while f < 8 {
        pset(82 + rnd(18), 75 + rnd(4), 7)
        f += 1
    }
    // grass
    rectfill(9, 80, 66, 118, 3)
    rectfill(9, 80, 66, 81, 11)
    rectfill(66, 82, 118, 118, 3)
    var g = 10
    while g < 118 {
        var top = g < 66 ? 80 : 82
        line(g, top, g + sin(t() * 2 + g) * 1.5, top - 3, 11)
        if g % 9 == 0 { pset(g, top - 4, g % 2 == 0 ? 8 : 10) }
        g += 3
    }
    // the two of them
    spr(flr(t() * 2) % 2 * 2, 30, 64, 2, 2)
    spr(38, 46, 64, 2, 2, true)
}

// they look up: the mountain, and something on top of it
func drawMountain() {
    var last = len(EPILOGUE) - 1
    rectfill(9, 9, 118, 118, 2)
    var s = 0
    while s < 20 {
        pset(12 + (s * 37) % 104, 12 + (s * 23) % 40, 7)
        s += 1
    }
    var my = 50
    while my <= 118 {
        var half = (my - 50) * 0.9
        line(max(9, 64 - half), my, min(118, 64 + half), my, my < 62 ? 7 : 5)
        my += 1
    }
    // the figure on the peak, red eyes; bigger on the last page before the end
    var big = page == last - 1
    var fr = big ? 6 : 3
    var fy = 50 - fr * 2 - 1
    circfill(64, fy, fr, 0)
    rectfill(64 - fr, fy, 64 + fr, fy + fr * 2, 0)
    if flr(t() * 3) % 9 != 0 {
        pset(62 - (big ? 1 : 0), fy, 8)
        pset(66 + (big ? 1 : 0), fy, 8)
    }
    // Pip and Brae, from behind, looking up
    spr(10, 18, 74, 2, 2)
    spr(38, 94, 74, 2, 2, true)
    // the last page fades to black
    if big and pageTime > 60 {
        var amount = min(1, (pageTime - 60) / 60)
        var y = 9
        while y < 119 {
            if (y % 4) / 4 < amount { line(9, y, 118, y, 0) }
            y += 1
        }
        if amount >= 1 { rectfill(9, 9, 118, 118, 0) }
    }
}

// a menu: a framed card with a title tab
func menuCard(title) {
    rectfill(12, 14, 115, 110, 0)
    rect(12, 14, 115, 110, 5)
    rectfill(40, 8, 87, 18, 3)
    rect(40, 8, 87, 18, 11)
    print(title, 64 - len(title) * 2, 11, 7)
}

func menuRow(on, label, value, y) {
    if on {
        rectfill(15, y - 2, 112, y + 6, 3)
        print(">", 17, y, 11)
    }
    print(label, 23, y, on ? 7 : 6)
    print(value, 110 - len(value) * 4, y, on ? 10 : 13)
}
// ---------- Bram and Wren on the mountain ----------

// where they stand (in the mountain's pixels) and which sprite they are
var NPCS = [
    {"who": "BRAM", "x": 28, "y": 344, "sprite": 40},
    {"who": "WREN", "x": 420, "y": 224, "sprite": 42}
]

// who Pip is standing next to, or none
func npcHere() {
    if not isHub() { return none }
    for n in NPCS {
        if abs(n["x"] + 8 - (px + 3)) < 14 and abs(n["y"] + 16 - (py + 12)) < 10 { return n }
    }
    return none
}

// what they say, depending on how far Pip has got
func npcTalk(n) {
    if n["who"] == "BRAM" {
        if shards == 0 {
            return ["BRAM: EVERY DOOR ON THE MOUNTAIN HIDES A SHARD. START WITH THE ONES DOWN HERE.",
                    "BRAM: THE ICE GATES MELT WHEN YOU CARRY ENOUGH SHARDS. THREE FOR THE FIRST ONE."]
        }
        if shards < 3 { return ["BRAM: " + shards + " SHARDS ALREADY! THE FIRST GATE NEEDS THREE. KEEP GOING."] }
        if shards < 8 { return ["BRAM: THE FIRST GATE MELTED! CLIMB THE STEPS ON THE RIGHT.", "BRAM: WREN THE OWL LIVES UP THERE. SHE KNOWS THE ICE."] }
        if shards < TOTAL - 1 { return ["BRAM: YOU ARE ALMOST AT THE TOP. I CAN SEE THE GREEN GLOW FROM HERE!"] }
        return ["BRAM: SOMETHING BIG IS WAITING AT THE TOP. BE CAREFUL. PIP."]
    }
    if shards < 8 {
        return ["WREN: HOO. A WARM ONE. SNOW SPRITES POP WITH ONE SWING.",
                "WREN: THREE QUICK SWINGS MAKE A COMBO. THE LAST ONE LUNGES.",
                "WREN: AND PRESS E TO THROW AN EMBER BOLT AT BATS."]
    }
    if shards < TOTAL - 1 {
        return ["WREN: CRACKED ICE BREAKS. FROM THE AIR. HOLD S AND SWING TO GROUND POUND."]
    }
    return ["WREN: THE YETI IS ONLY HURT WHEN IT IS DIZZY. AFTER IT SLAMS DOWN OR HITS A WALL.",
            "WREN: AN EMBER BOLT IN ITS FACE WILL STOP IT MID ATTACK. HOO."]
}

func drawNpcs() {
    if not isHub() { return }
    var here = npcHere()
    for n in NPCS {
        var bob = n["who"] == "WREN" ? flr(sin(t() * 2) * 1.5) : 0
        spr(n["sprite"], n["x"], n["y"] + bob, 2, 2, px + 3 < n["x"] + 8)
        if here == n {
            rectfill(n["x"] + 8 - len(n["who"]) * 2 - 2, n["y"] - 12, n["x"] + 8 + len(n["who"]) * 2, n["y"] - 4, 1)
            print(n["who"], n["x"] + 8 - len(n["who"]) * 2, n["y"] - 10, 7)
            if flr(t() * 3) % 2 == 0 { print("S", n["x"] + 6, n["y"] - 20, 10) }
        }
    }
}

// ---------- cheats (F1) ----------

var god = false
var oneHit = false
var infDash = false
var cheatLevel = 0
var cmenu = 0
var cheatFrom = "title"
var CHEAT_ROWS = 7
var ORDER = [0, 1, 2, 3, 4, 5, 6, 7, 8]

func openCheats(from) {
    cheatFrom = from
    mode = "cheats"
    cmenu = 0
    cheatLevel = max(0, indexOf(ORDER, level))
}

func teleport(n) {
    resetTiles()
    if cheatFrom == "title" {
        shards = 0
        berries = 0
        deaths = 0
        done = []
        seen = []
        hubPX = -1
        startTime = t()
    }
    level = n
    mode = "play"
    lines = []
    freeze = 6
    startLevel()
}

func updateCheats() {
    if btnp(2) { cmenu = (cmenu + CHEAT_ROWS - 1) % CHEAT_ROWS }
    if btnp(3) { cmenu = (cmenu + 1) % CHEAT_ROWS }
    if cmenu == 0 {
        if btnp(0) or keyp("a") { cheatLevel = (cheatLevel + len(ORDER) - 1) % len(ORDER) }
        if btnp(1) or keyp("d") { cheatLevel = (cheatLevel + 1) % len(ORDER) }
    }
    var my = mousey()
    if mousex() - OX > 8 and mousex() - OX < 120 and my >= 22 and my < 22 + CHEAT_ROWS * 11 and click() {
        cmenu = flr((my - 22) / 11)
        cheatChoose()
        return
    }
    if keyp("enter") or btnp(4) { cheatChoose() }
    if keyp("f1") {
        mode = cheatFrom
        freeze = 6
    }
}

func cheatChoose() {
    play(3)
    if cmenu == 0 {
        teleport(ORDER[cheatLevel])
    } else if cmenu == 1 {
        god = not god
    } else if cmenu == 2 {
        oneHit = not oneHit
    } else if cmenu == 3 {
        infDash = not infDash
    } else if cmenu == 4 {
        if cheatFrom == "play" {
            mode = "play"
            freeze = 4
            if isBoss() and bstate != "dead" {
                bhp = 0
                bstate = "dying"
                btimer = 1
            } else if not isHub() {
                shards += 1
                push(done, level)
                won = 1
            }
        }
    } else if cmenu == 5 {
        // every shard but the yeti's: all the gates open
        shards = TOTAL - 1
        done = []
        var i = 0
        while i < len(LEVELS) {
            if i != BOSS and i != HUB { push(done, i) }
            i += 1
        }
        if cheatFrom == "play" and isHub() {
            for g in GATES { setTile(g["x"], g["y"], 0) }
        }
    } else {
        mode = cheatFrom
        freeze = 6
    }
}

func drawCheats() {
    cls(2)
    menuCard("CHEATS")
    var names = ["GO TO LEVEL", "NEVER DIE", "ONE HIT YETI", "ENDLESS DASH", "WIN LEVEL", "ALL SHARDS", "BACK"]
    var i = 0
    while i < CHEAT_ROWS {
        var value = ""
        if i == 0 { value = "< " + cheatLevel + " >" }
        if i == 1 { value = god ? "ON" : "OFF" }
        if i == 2 { value = oneHit ? "ON" : "OFF" }
        if i == 3 { value = infDash ? "ON" : "OFF" }
        if i == 5 { value = shards + "/" + TOTAL }
        menuRow(i == cmenu, names[i], value, 24 + i * 11)
        i += 1
    }
    var nm = LEVELS[ORDER[cheatLevel]]["name"]
    print(nm, 64 - len(nm) * 2, 104, 11)
    print("ARROWS. ENTER OR CLICK. F1 BACK", 2, 116, 13)
}

// ---------- the yeti ----------

var FLOOR = 104
var bx = 0
var by = 0
var bvx = 0
var bvy = 0
var bhp = 0
var bstate = "intro"
var btimer = 0
var bface = -1
var bflash = 0
var banger = 0
var bstep = 0
var hitstop = 0
var flash = 0
var atkTime = 0
var atkCool = 0
var balls = []
var waves = []
var rings = []
var drops = []
var fog = []
var streaks = []
var shardDrop = none

// one item from a list, at random
func pick(list) { return list[flr(rnd(len(list)))] }

func isBoss() { return has(LEVELS[level], "boss") }

func initBoss() {
    bx = W * 4 - 16
    by = FLOOR
    bvx = 0
    bvy = 0
    bhp = 8
    banger = 0
    bstate = "intro"
    btimer = 100
    bface = -1
    bflash = 0
    balls = []
    waves = []
    rings = []
    drops = []
    shardDrop = none
    if len(fog) == 0 {
        var i = 0
        while i < 10 {
            push(fog, {"x": rnd(320), "y": 16 + rnd(100), "r": 10 + rnd(14), "s": 0.2 + rnd(0.5)})
            i += 1
        }
        i = 0
        while i < 34 {
            push(streaks, {"x": rnd(228), "y": rnd(128), "s": 2 + rnd(3)})
            i += 1
        }
    }
}

// where the shard in his head is: high up, or low and forward when he is dizzy
func headX() {
    if bstate == "stunned" { return bx + bface * 12 }
    return bx + bface * 3
}
func headY() {
    if bstate == "stunned" { return by - 22 }
    return by - 46
}

func hitPip(x, y, r) {
    return dead == 0 and x + r > px and x - r < px + 6 and y + r > py and y - r < py + 12
}

func dropIcicles(n) {
    var i = 0
    while i < n {
        push(drops, {"x": 16 + rnd(W * 8 - 32), "y": 8, "v": 0, "wait": 20 + i * 10})
        i += 1
    }
}

func pickAttack() {
    var r = rnd(3)
    // angrier phases add new attacks: ice breath (phase 2) and icicle rain (phase 3)
    if banger >= 1 and rnd(1) < 0.3 {
        bstate = "breath"
        btimer = 90
        bface = px + 3 < bx ? -1 : 1
        return
    }
    if banger >= 2 and rnd(1) < 0.35 {
        bstate = "rain"
        btimer = 70
        return
    }
    if r < 1 {
        bstate = "crouch"
        btimer = 38 - banger * 4
    } else if r < 2 {
        bstate = "windup"
        btimer = 38 - banger * 4
    } else {
        bstate = "rev"
        bface = px + 3 < bx ? -1 : 1
        btimer = 48 - banger * 5
    }
}

func land() {
    shake(10)
    play(4)
    flash = 2
    push(waves, {"x": bx - 16, "d": -1, "life": 90})
    push(waves, {"x": bx + 16, "d": 1, "life": 90})
    push(rings, {"x": bx, "y": by, "r": 6})
    burst(bx, by - 2, 25, 7, 2)
    dropIcicles(1 + banger)
    bstate = "stunned"
    btimer = 160 - banger * 15
}

// Pip's swing: it only hurts the yeti when he is dizzy and the swing reaches the shard
func strike(amount) {
    if bstate == "dying" or bstate == "dead" or bstate == "intro" { return }
    var sx = px + 3 + facing * 10
    var sy = py + 6
    if abs(sx - headX()) < 20 and abs(sy - headY()) < 20 {
        if bstate == "stunned" {
            hurtBoss(amount)
        } else {
            burst(sx, sy, 6, 10, 1)
            play(2)
            vx = -facing * 2
        }
    }
}

// an ember bolt in the face: it hurts him while he's dizzy, and stops an attack he's winding up
func boltHitBoss() {
    if bstate == "dying" or bstate == "dead" or bstate == "intro" { return }
    if bstate == "stunned" {
        hurtBoss(1)
    } else if bstate == "crouch" or bstate == "windup" or bstate == "rev" or bstate == "breath" {
        bstate = "stunned"
        btimer = 70
        balls = filter(balls, func(b) { return not has(b, "breath") })
        burst(headX(), headY(), 16, 9, 1.4)
        shake(4)
        play(5)
    } else {
        burst(headX(), headY(), 6, 9, 0.8)
    }
}

func hurtBoss(amount) {
    if bstate == "dying" or bstate == "dead" or bstate == "hurt" { return }
    if oneHit { amount = 99 }
    if true {
        if true {
            bhp -= amount
            hitstop = 6
            flash = 3
            bflash = 12
            shake(7)
            play(5)
            burst(headX(), headY(), 25, 11, 2)
            burst(headX(), headY(), 15, 7, 1.5)
            push(rings, {"x": headX(), "y": headY(), "r": 3})
            var was = banger
            banger = 0
            if bhp <= 5 { banger = 1 }
            if bhp <= 2 { banger = 2 }
            if banger > was and bhp > 0 {
                // a new phase: he roars, and fights harder
                shake(10)
                push(rings, {"x": headX(), "y": headY(), "r": 4})
                push(rings, {"x": headX(), "y": headY(), "r": 16})
            }
            if bhp <= 0 {
                bstate = "dying"
                btimer = 120
            } else {
                bstate = "hurt"
                btimer = 30
                bvx = facing * 3
            }
        }
    }
}

func updateBoss() {
    if bflash > 0 { bflash -= 1 }
    for b in balls {
        b["x"] += b["vx"]
        b["y"] += b["vy"]
        if not has(b, "breath") { b["vy"] += 0.15 }
        if hitPip(b["x"], b["y"], 4) { die() }
        if b["y"] > FLOOR - 3 or b["x"] < 8 or b["x"] > W * 8 - 8 {
            b["gone"] = true
            burst(b["x"], b["y"], 12, 7, 1.2)
            push(rings, {"x": b["x"], "y": b["y"], "r": 2})
        }
    }
    balls = filter(balls, func(b) { return not has(b, "gone") })
    for w in waves {
        w["x"] += w["d"] * 1.8
        w["life"] -= 1
        if w["life"] % 3 == 0 { burst(w["x"], FLOOR - 2, 2, 7, 0.6) }
        if abs(w["x"] - (px + 3)) < 5 and py + 12 > FLOOR - 7 { die() }
    }
    waves = filter(waves, func(w) { return w["life"] > 0 and w["x"] > 8 and w["x"] < W * 8 - 8 })
    for r in rings { r["r"] += 2 }
    rings = filter(rings, func(r) { return r["r"] < 40 })
    for d in drops {
        if d["wait"] > 0 {
            d["wait"] -= 1
        } else {
            d["v"] = min(d["v"] + 0.35, 6)
            d["y"] += d["v"]
            if hitPip(d["x"], d["y"] + 4, 3) { die() }
            if d["y"] > FLOOR - 8 {
                d["gone"] = true
                burst(d["x"], FLOOR - 2, 10, 12, 1)
            }
        }
    }
    drops = filter(drops, func(d) { return not has(d, "gone") })

    if shardDrop != none {
        shardDrop["vy"] = min(shardDrop["vy"] + 0.2, 3)
        shardDrop["y"] = min(shardDrop["y"] + shardDrop["vy"], FLOOR - 8)
        if hitPip(shardDrop["x"] + 4, shardDrop["y"] + 4, 6) {
            shards += 1
            play(5)
            flash = 8
            shake(6)
            burst(shardDrop["x"] + 4, shardDrop["y"] + 4, 50, 11, 2)
            burst(shardDrop["x"] + 4, shardDrop["y"] + 4, 30, 7, 1.5)
            shardDrop = none
            won = 90
        }
        return
    }
    if bstate == "dead" { return }

    var target = px + 3
    btimer -= 1
    if bstate == "intro" {
        if btimer == 60 {
            shake(12)
            play(4)
            push(rings, {"x": headX(), "y": headY(), "r": 4})
            push(rings, {"x": headX(), "y": headY(), "r": 14})
        }
        if btimer <= 0 {
            bstate = "idle"
            btimer = 75
        }
    } else if bstate == "idle" {
        bface = target < bx ? -1 : 1
        bx += bface * (0.4 + banger * 0.2)
        bstep += 1
        if btimer <= 0 { pickAttack() }
    } else if bstate == "crouch" {
        if btimer <= 0 {
            bstate = "air"
            bvy = -6
            bvx = clamp((target - bx) / 40, -3, 3)
            play(1)
        }
    } else if bstate == "air" {
        bx += bvx
        bvy += 0.3
        by += bvy
        if by >= FLOOR and bvy > 0 {
            by = FLOOR
            land()
        }
    } else if bstate == "windup" {
        bface = target < bx ? -1 : 1
        if btimer <= 0 {
            var n = 1 + flr(banger / 2)
            var i = 0
            while i < n {
                push(balls, {"x": bx + bface * 16, "y": by - 44, "vx": (target - bx) / 45 + (i - (n - 1) / 2) * 0.7, "vy": -3.2 - i * 0.3})
                i += 1
            }
            play(2)
            shake(2)
            bstate = "idle"
            btimer = 75 - banger * 8
        }
    } else if bstate == "rev" {
        if btimer % 6 == 0 { burst(bx - bface * 10, by - 2, 3, 6, 0.8) }
        if btimer <= 0 {
            bstate = "charge"
            bvx = bface * (2.2 + banger * 0.4)
            play(1)
        }
    } else if bstate == "charge" {
        bx += bvx
        if btimer % 3 == 0 { burst(bx - bface * 12, by - 2, 2, 7, 0.6) }
        if bx < 32 or bx > W * 8 - 32 {
            bx = clamp(bx, 32, W * 8 - 32)
            shake(9)
            play(4)
            flash = 2
            push(rings, {"x": bx + bface * 18, "y": by - 24, "r": 4})
            dropIcicles(1 + banger)
            bstate = "stunned"
            btimer = 170 - banger * 15
        }
    } else if bstate == "breath" {
        // ice breath: a spray of ice shards from his mouth, sweeping toward Pip
        if btimer < 70 and btimer % 5 == 0 {
            var aim = atan2(py + 6 - headY(), px + 3 - headX()) + sin(btimer * 0.15) * 0.35
            push(balls, {"x": headX() + bface * 8, "y": headY() + 4, "vx": cos(aim) * 2.4, "vy": sin(aim) * 2.4, "breath": 1})
            play(1)
        }
        if btimer <= 0 {
            bstate = "idle"
            btimer = 60
        }
    } else if bstate == "rain" {
        // he roars and the ceiling comes down
        if btimer == 60 {
            shake(12)
            play(4)
            push(rings, {"x": headX(), "y": headY(), "r": 4})
            push(rings, {"x": headX(), "y": headY(), "r": 18})
        }
        if btimer == 40 { dropIcicles(6 + banger * 2) }
        if btimer <= 0 {
            bstate = "idle"
            btimer = 55
        }
    } else if bstate == "stunned" {
        if dashTime > 0 and px + 6 > bx - 18 and px < bx + 18 and py + 12 > by - 46 and py < by {
            hurtBoss(1)   // a dash into him while he's dizzy
        }
        if btimer <= 0 {
            bstate = "idle"
            btimer = 40
        }
    } else if bstate == "hurt" {
        bx += bvx
        bvx *= 0.85
        if btimer <= 0 {
            bstate = "crouch"
            btimer = 18
        }
    } else if bstate == "dying" {
        if btimer % 5 == 0 {
            burst(bx + rnd(40) - 20, by - rnd(50), 15, pick([7, 6, 12, 11]), 1.5)
            shake(4)
            play(4)
        }
        if btimer <= 0 {
            bstate = "dead"
            flash = 12
            shake(12)
            burst(bx, by - 30, 60, 7, 2.5)
            burst(bx, by - 30, 40, 11, 2)
            shardDrop = {"x": bx - 4, "y": by - 54, "vy": -3}
        }
    }
    bx = clamp(bx, 30, W * 8 - 30)   // (the arena can be any width)

    // touching the yeti hurts, unless he is down
    if bstate == "charge" or bstate == "air" {
        if px + 6 > bx - 15 and px < bx + 15 and py + 12 > by - 40 and py < by { die() }
    }
}

func drawYeti() {
    if bstate == "dead" { return }
    var sq = 0
    if bstate == "crouch" { sq = 4 + rnd(2) }
    if bstate == "stunned" { sq = 14 }
    var sx = 0
    if bstate == "crouch" or bstate == "rev" or bstate == "dying" { sx = rnd(3) - 1.5 }
    var x = bx + sx
    var y = by
    var bob = 0
    if bstate == "idle" { bob = abs(sin(bstep * 0.08)) * 2 }
    if bflash > 0 and bflash % 4 < 2 {
        pal(7, 8)
        pal(6, 8)
        pal(13, 2)
    }
    // big furry feet, stepping as he walks
    var stride = sin(bstep * 0.15) * 2
    if bstate == "charge" { stride = sin(t() * 25) * 3 }
    drawFoot(x - 9, y - max(0, stride))
    drawFoot(x + 9, y - max(0, -stride))
    // body: outline, fur, shaded belly, tufts
    var cy = y - 24 + sq * 0.6 - bob
    circfill(x, cy, 19, 1)
    circfill(x, cy, 18, 7)
    circfill(x + bface * 4, cy + 4, 11, 6)
    var i = 0
    while i < 9 {
        var a = i * 0.7 + 0.3
        pset(x + cos(a) * 15, cy + sin(a) * 15, 6)
        pset(x + cos(a + 0.4) * 10, cy + sin(a + 0.4) * 12, 13)
        i += 1
    }
    // arms: swing when walking, up to throw, up when leaping
    var armY = cy + 2 + sin(bstep * 0.15) * 3
    if bstate == "windup" { armY = cy - 16 }
    if bstate == "air" { armY = cy - 10 }
    if bstate == "stunned" { armY = cy + 8 }
    circfill(x - 20, armY, 8, 1)
    circfill(x + 20, armY, 8, 1)
    circfill(x - 20, armY, 7, 7)
    circfill(x + 20, armY, 7, 7)
    circfill(x - 21, armY + 4, 4, 6)
    circfill(x + 21, armY + 4, 4, 6)
    if bstate == "windup" {
        circfill(x + bface * 20, armY - 9, 6, 1)
        circfill(x + bface * 20, armY - 9, 5, 7)
    }
    // head and horns
    var hx = headX() + sx
    var hy = headY() - bob
    if bstate == "crouch" { hy += sq }
    circfill(hx, hy, 12, 1)
    circfill(hx, hy, 11, 7)
    line(hx - 9, hy - 6, hx - 14, hy - 14, 6)
    line(hx - 8, hy - 7, hx - 13, hy - 15, 6)
    line(hx + 9, hy - 6, hx + 14, hy - 14, 6)
    line(hx + 8, hy - 7, hx + 13, hy - 15, 6)
    // face
    // face: a blue-grey muzzle under a fringe of fur
    var fx = hx + bface * 2
    circfill(fx, hy + 2, 7, 5)
    circfill(fx, hy + 2, 6, 13)
    circfill(fx, hy + 5, 4, 6)
    var j = -6
    while j <= 6 {
        line(fx + j, hy - 6, fx + j + 1, hy - 2, 7)
        j += 2
    }
    drawFace(fx, hy)
    // the shard in his forehead, glowing
    var glow = 3 + sin(t() * 6) * 1.5
    if bstate == "stunned" { glow += 3 }
    circ(hx, hy - 11, glow + 4, 3)
    circ(hx, hy - 11, glow + 2, 11)
    spr(109, hx - 4, hy - 15)
    pal()
    if bstate == "stunned" {
        var s = 0
        while s < 3 {
            var a = t() * 4 + s * 2.1
            rectfill(hx + cos(a) * 14, hy - 18 + sin(a) * 4, hx + cos(a) * 14 + 1, hy - 17 + sin(a) * 4, 10)
            s += 1
        }
    }
}

// his face changes with what he is doing
func drawFace(fx, hy) {
    var s = bstate
    rectfill(fx - 1, hy + 3, fx + 1, hy + 4, 1)
    // eyes
    if s == "stunned" {
        line(fx - 4, hy - 1, fx - 2, hy + 1, 1)
        line(fx - 4, hy + 1, fx - 2, hy - 1, 1)
        line(fx + 2, hy - 1, fx + 4, hy + 1, 1)
        line(fx + 2, hy + 1, fx + 4, hy - 1, 1)
    } else if s == "hurt" or s == "dying" {
        line(fx - 4, hy - 1, fx - 2, hy, 1)
        line(fx - 4, hy + 1, fx - 2, hy, 1)
        line(fx + 4, hy - 1, fx + 2, hy, 1)
        line(fx + 4, hy + 1, fx + 2, hy, 1)
    } else {
        var r = 2
        if s == "air" { r = 3 }
        // glowing eyes (no dark circles round them)
        var c = 8
        if s == "charge" or s == "rev" { c = 10 }
        var e = r - 1
        if s == "windup" {
            line(fx - bface * 3 - 2, hy, fx - bface * 3 + 2, hy, 1)
            rectfill(fx + bface * 3 - e, hy - e + 1, fx + bface * 3 + e - 1, hy + e - 1, c)
        } else {
            rectfill(fx - 3 - e, hy - e + 1, fx - 3 + e - 1, hy + e - 1, c)
            rectfill(fx + 3 - e + 1, hy - e + 1, fx + 3 + e, hy + e - 1, c)
        }
    }
    // brows
    if s == "crouch" or s == "rev" or s == "charge" or s == "intro" {
        line(fx - 6, hy - 5, fx - 1, hy - 2, 1)
        line(fx + 6, hy - 5, fx + 1, hy - 2, 1)
    } else if s == "dying" or s == "hurt" {
        line(fx - 6, hy - 2, fx - 1, hy - 4, 1)
        line(fx + 6, hy - 2, fx + 1, hy - 4, 1)
    } else if s == "windup" {
        line(fx - bface * 6, hy - 3, fx - bface * 1, hy - 3, 1)
        line(fx + bface * 1, hy - 3, fx + bface * 6, hy - 5, 1)
    } else if s == "air" {
        line(fx - 6, hy - 5, fx - 1, hy - 5, 1)
        line(fx + 6, hy - 5, fx + 1, hy - 5, 1)
    }
    // mouth
    if s == "intro" or s == "charge" or s == "rev" or s == "breath" or s == "rain" {
        circfill(fx, hy + 7, 3, 1)
        circfill(fx, hy + 8, 1, 8)
        line(fx - 3, hy + 5, fx - 2, hy + 8, 7)
        line(fx + 3, hy + 5, fx + 2, hy + 8, 7)
    } else if s == "crouch" {
        rectfill(fx - 4, hy + 6, fx + 4, hy + 8, 1)
        line(fx - 3, hy + 7, fx + 3, hy + 7, 7)
        pset(fx - 1, hy + 7, 1)
        pset(fx + 1, hy + 7, 1)
    } else if s == "air" {
        circfill(fx, hy + 7, 2, 1)
    } else if s == "windup" {
        line(fx - bface * 3, hy + 7, fx + bface * 3, hy + 5, 1)
        pset(fx + bface * 2, hy + 6, 7)
    } else if s == "stunned" {
        line(fx - 3, hy + 7, fx - 1, hy + 6, 1)
        line(fx - 1, hy + 6, fx + 1, hy + 7, 1)
        line(fx + 1, hy + 7, fx + 3, hy + 6, 1)
        rectfill(fx + 1, hy + 7, fx + 2, hy + 9, 8)
    } else if s == "hurt" or s == "dying" {
        circfill(fx, hy + 7, 2, 1)
        line(fx - 2, hy + 6, fx + 2, hy + 6, 7)
        if s == "dying" {
            pset(fx - 4, hy + 2 + (t() * 12) % 5, 12)
            pset(fx + 4, hy + 2 + (t() * 12 + 2) % 5, 12)
        }
    } else {
        line(fx - 3, hy + 7, fx + 3, hy + 7, 1)
        pset(fx - 3, hy + 8, 1)
        pset(fx + 3, hy + 8, 1)
        pset(fx - 2, hy + 6, 7)
        pset(fx + 2, hy + 6, 7)
    }
    // angry: red streaks off the eyes; charging: steam from his nose
    if banger > 0 and s != "stunned" and s != "hurt" and s != "dying" {
        pset(fx - 3 - bface * (2 + rnd(3)), hy - rnd(2), 8)
        pset(fx + 3 - bface * (2 + rnd(3)), hy - rnd(2), 8)
    }

    if (s == "rev" or s == "charge") and rnd(1) < 0.3 { burst(fx + bface * 2, hy + 4, 1, 6, 0.4) }
}

func drawFoot(fx, fy) {
    circfill(fx, fy - 6, 7, 1)
    circfill(fx, fy - 6, 6, 7)
    circfill(fx + 1, fy - 4, 4, 6)
    rectfill(fx - 7, fy - 3, fx + 7, fy, 1)
    rectfill(fx - 6, fy - 3, fx + 6, fy - 1, 7)
    pset(fx - 4, fy, 5)
    pset(fx, fy, 5)
    pset(fx + 4, fy, 5)
}

func drawHazards() {
    for r in rings {
        circ(r["x"], r["y"], r["r"], 7)
        if r["r"] > 4 { circ(r["x"], r["y"], r["r"] - 3, 12) }
    }
    for d in drops {
        if d["wait"] > 0 and d["wait"] % 4 < 2 {
            var yy = 12
            while yy < FLOOR {
                pset(d["x"], yy, 8)
                yy += 6
            }
        }
        spr(144, d["x"] - 4, d["y"])
    }
    for w in waves {
        var h = 6 + sin(w["life"] * 0.6) * 2
        rectfill(w["x"] - 2, FLOOR - h, w["x"] + 2, FLOOR - 1, 7)
        rectfill(w["x"] - 1, FLOOR - h - 3, w["x"] + 1, FLOOR - h, 12)
    }
    for b in balls {
        circfill(b["x"], b["y"], 5, 1)
        circfill(b["x"], b["y"], 4, 7)
        circfill(b["x"] + 1, b["y"] + 1, 2, 6)
    }
    if shardDrop != none {
        circ(shardDrop["x"] + 4, shardDrop["y"] + 4, 6 + sin(t() * 8) * 2, 11)
        circ(shardDrop["x"] + 4, shardDrop["y"] + 4, 10 + sin(t() * 8) * 2, 3)
        spr(109, shardDrop["x"], shardDrop["y"])
    }
}

// fog: drifting banks of mist (every other line, flickering) and a blizzard
func drawFog(camx) {
    var phase = flr(t() * 12) % 3
    for f in fog {
        f["x"] += f["s"]
        var cx = (f["x"] - camx * 0.7) % 320 - 60
        if cx < -60 { cx += 320 }
        var r = f["r"]
        var dy = -r + phase
        while dy <= r {
            var hw = sqrt(max(0, r * r - dy * dy))
            line(cx - hw, f["y"] + dy, cx + hw, f["y"] + dy, 6)
            dy += 3
        }
    }
    for s in streaks {
        s["x"] -= s["s"]
        s["y"] += s["s"] * 0.3
        if s["x"] < -6 {
            s["x"] = SW + 6
            s["y"] = rnd(128)
        }
        if s["y"] > 128 { s["y"] = 0 }
        line(s["x"], s["y"], s["x"] + 4, s["y"] - 1, 7)
    }
}

// ---------- drawing ----------

func draw() {
    camera(-OX, 0)   // menus and story screens: 128 wide, in the middle (the level sets its own camera below)
    if mode == "settings" {
        drawSettings()
        return
    }
    if mode == "cheats" {
        drawCheats()
        return
    }
    if mode == "title" {
        drawTitle()
        return
    }
    if mode == "epilogue" {
        drawEpilogue()
        return
    }
    if mode == "end" {
        drawEnd()
        return
    }
    var L = LEVELS[level]
    var camx = clamp(px + 3 - SW / 2, 0, W * 8 - SW)
    camy = clamp(py + 6 - 64, 0, H * 8 - 128)
    cls(L["sky"])
    drawBackdrop(camx)
    camera(camx, camy)
    map(L["x"], L["y"], 0, 0, W, H)
    drawDoors()
    drawNpcs()
    drawIcicles()
    drawEnemies()
    if isBoss() {
        drawHazards()
        drawYeti()
    }
    if dead == 0 { drawPip() }
    camera()
    if isBoss() { drawFog(camx) }
    camera(-OX, 0)
    if levelTime < 90 and len(lines) == 0 {
        rectfill(0, 54, 127, 70, 1)
        print(L["name"], 64 - len(L["name"]) * 2, 60, 7)
    }
    if flash > 0 {
        if flash > 2 {
            rectfill(-OX, 0, SW, 127, 7)
        } else {
            var fy = flr(t() * 30) % 2
            while fy < 128 {
                line(-OX, fy, SW, fy, 7)
                fy += 2
            }
        }
    }
    camera(camx, camy)   // so the particles line up with the world
}

func drawBackdrop(camx) {
    var sky = LEVELS[level]["sky"]
    if contains([3, 4, 5, 8, 10, 12, 14], level) {
        // cave: far rock and glints
        var i = 0
        while i < 14 {
            var x = i * 24 - (camx * 0.3) % 24
            circfill(x, 0, 14, 2)
            circfill(x + 12, 128, 16, 2)
            pset(x + 5, 40 + (i * 37) % 50, 13)
            i += 1
        }
        return
    }
    var far = 6
    var near = 3
    if level == 2 or level == 11 {
        far = 14
        near = 2
    }
    if level == 6 {
        far = 7
        near = 13
    }
    if level == 7 or level == 13 {
        far = 7
        near = 6
    }
    // clouds
    var j = 0
    while j < 6 {
        var cx = j * 50 - (camx * 0.1) % 50
        var cy = 14 + (j * 23) % 30
        circfill(cx, cy, 6, 7)
        circfill(cx + 7, cy + 2, 5, 7)
        circfill(cx - 7, cy + 2, 4, 7)
        j += 1
    }
    // far mountains, then near hills, moving slower than the world
    var k = 0
    while k < 8 {
        var mx = k * 40 - (camx * 0.2) % 40
        circfill(mx, 150, 46, far)
        k += 1
    }
    k = 0
    while k < 10 {
        var hx = k * 26 - (camx * 0.45) % 26
        circfill(hx, 140, 24, near)
        k += 1
    }
    if contains([6, 7, 13], level) {
        for f in snow {
            f["y"] += f["s"]
            f["x"] -= f["s"] * 0.6
            if f["y"] > 128 { f["y"] = 0 }
            if f["x"] < 0 { f["x"] = SW }
            pset(f["x"], f["y"], 7)
        }
    }
}

func drawPip() {
    var f = flr(t() * 2) % 2
    if dashTime > 0 {
        f = 7
    } else if not grounded and wall != 0 and vy > 0 {
        f = 8
    } else if not grounded {
        f = vy < 0 ? 5 : 6
    } else if abs(vx) > 0.3 {
        f = RUN[flr(steps / 5) % 4]
    }
    if atkTime > 0 and dashTime == 0 { f = atkTime > 5 ? 9 : 10 }
    var n = f * 2
    if f == 8 { n = 32 }
    if f == 9 { n = 34 }
    if f == 10 { n = 36 }
    var flip = facing < 0
    if f == 8 { flip = wall < 0 }
    // scarf behind him: red, blue when the dash is used up
    var col = 8
    var size = 2
    for p in scarf {
        circfill(p["x"], p["y"], size, col)
        size = max(1, size - 0.3)
    }
    spr(n, px - 5, py - 4, 2, 2, flip)
    pal()
    if wallCharge or wallRun > 0 {
        // his eyes glow green while the wall crystal is ready (or working)
        var ex = n == 14 ? 9 : 8
        var ey = n == 2 ? 8 : (n == 6 ? 6 : 7)
        for k in [0, 2] {
            var gx = flip ? px - 5 + 15 - ex - k : px - 5 + ex + k
            pset(gx, py - 4 + ey, 11)
            if flr(t() * 8) % 2 == 0 { pset(gx - facing, py - 4 + ey, 3) }   // a flicker trailing behind
        }
    }
    // the ember: a little warm spark on the scarf while the dash is ready
    if canDash and dashTime == 0 {
        var tip = scarf[len(scarf) - 1]
        pset(tip["x"] + rnd(2) - 1, tip["y"] - 2 - rnd(2), pick([9, 10, 10, 7]))
        pset(tip["x"], tip["y"] - 1, 10)
    }
    if atkTime > 0 and atkTime <= 5 {
        var ax = px + 3 + facing * 9
        var k = (5 - atkTime) * 0.8
        line(ax, py - 2 + k, ax + facing * 6, py + 6, 7)
        line(ax + facing * 6, py + 6, ax, py + 14 - k, 7)
        line(ax - facing, py, ax + facing * 4, py + 6, 12)
        line(ax + facing * 4, py + 6, ax - facing, py + 12, 12)
    }
}

var LOGO = [
    ["11111", "10000", "11111", "00001", "11111"],
    ["10001", "10001", "11111", "10001", "10001"],
    ["01110", "10001", "11111", "10001", "10001"],
    ["11110", "10001", "11110", "10100", "10011"],
    ["11110", "10001", "10001", "10001", "11110"]
]
var tmenu = 0

// the big SHARD letters, drawn from little pixel maps
func drawLogo(x, y, s) {
    var k = 0
    while k < 5 {
        var row = 0
        while row < 5 {
            var col = 0
            while col < 5 {
                if slice(LOGO[k][row], col, col + 1) == "1" {
                    var px0 = x + k * (s * 5 + s) + col * s
                    var py0 = y + row * s
                    rectfill(px0 + 1, py0 + 2, px0 + s, py0 + s + 1, 3)
                    rectfill(px0, py0, px0 + s - 1, py0 + s - 1, row == 0 ? 7 : 11)
                }
                col += 1
            }
            row += 1
        }
        k += 1
    }
}

func updateTitle() {
    if btnp(2) or btnp(3) or keyp("w") or keyp("s") { tmenu = 1 - tmenu }
    var my = mousey()
    var picked = false
    if click() and mousex() - OX > 40 and mousex() - OX < 88 {
        if my >= 64 and my < 73 {
            tmenu = 0
            picked = true
        }
        if my >= 74 and my < 83 {
            tmenu = 1
            picked = true
        }
    }
    if picked or keyp("enter") or btnp(4) or hit("jump") or keyp("space") {
        if tmenu == 0 {
            startGame()
        } else {
            openSettings("title")
        }
    }
}

func drawTitle() {
    cls(1)
    // stars
    var i = 0
    while i < 40 {
        var c = (i + flr(t() * 2)) % 9 == 0 ? 7 : 13
        pset((i * 53) % SW - OX, (i * 29) % 70, c)
        i += 1
    }
    // mountains: a far range, then the big peak with the shard above it
    var y = 60
    while y < 128 {
        var a = (y - 60) * 1.4
        line(20 - a, y, 20 + a, y, 2)
        line(-40 - a, y, -40 + a, y, 2)
        line(168 - a, y, 168 + a, y, 2)
        line(108 - a, y, 108 + a, y, 2)
        y += 1
    }
    y = 52
    while y < 128 {
        var half = (y - 52) * 1.1
        line(64 - half, y, 64 + half, y, y < 61 ? 7 : 5)
        y += 1
    }
    var glow = 2 + sin(t() * 3) * 2
    circ(64, 44 + sin(t() * 2), 6 + glow, 3)
    spr(109, 60, 40 + sin(t() * 2))
    // snowy ground and Pip
    rectfill(-OX, 104, SW, 127, 7)
    rectfill(-OX, 104, SW, 105, 6)
    var s = 0
    while s < 5 {
        circfill(18 - s * 3, 95 + sin(t() * 6 + s) * 1.5, max(1, 2 - s * 0.3), 8)
        s += 1
    }
    spr(flr(t() * 2) % 2 * 2, 18, 88, 2, 2)
    // falling snow
    for f in snow {
        f["y"] += f["s"]
        f["x"] -= f["s"] * 0.5
        if f["y"] > 128 { f["y"] = 0 }
        if f["x"] < 0 { f["x"] = SW }
        pset(f["x"] - OX, f["y"], 7)
    }
    drawLogo(20, 8, 3)
    print("PIP AND THE EMERALD HEART", 14, 26, 6)
    // the menu
    var names = ["START", "SETTINGS"]
    var k = 0
    while k < 2 {
        var ry = 66 + k * 10
        if k == tmenu {
            rectfill(40, ry - 2, 87, ry + 6, 3)
            print(">", 42, ry, 11)
        }
        print(names[k], 64 - len(names[k]) * 2, ry, k == tmenu ? 7 : 6)
        k += 1
    }
    if dget(0) > 0 { print("BEST " + fixed(dget(0), 1) + "S", 84, 120, 5) }
}
func drawEnd() {
    cls(1)
    menuCard("THE END")
    var glow = 2 + sin(t() * 3) * 2
    circ(64, 38, 12 + glow, 3)
    sspr(104, 48, 8, 8, 52, 26, 24, 24)
    print("THE HEART IS WHOLE", 28, 58, 11)
    print("COINS  " + berries + " / " + BERRIES, 64 - (10 + len("" + berries)) * 2, 72, 7)
    print("FALLS  " + deaths, 64 - (7 + len("" + deaths)) * 2, 81, 7)
    var tm = fixed(finishTime, 1) + "S"
    print("TIME  " + tm, 64 - (6 + len(tm)) * 2, 90, 10)
    if flr(t() * 2) % 2 == 0 { print("PRESS SPACE", 42, 116, 6) }
}
